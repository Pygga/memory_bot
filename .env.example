# Telegram Bot Token (от @BotFather)
BOT_TOKEN=

# PostgreSQL Database URL
DATABASE_URL=postgresql+asyncpg://memorybot:memorybot_password@localhost:5432/memorybot

# Groq API Key (для транскрипции аудио и vision)
GROQ_API_KEY=

# Redis URL (опционально, для кэширования)
REDIS_URL=redis://localhost:6379/0

# Invite Code (оставь пустым для открытого доступа)
INVITE_CODE=

# Admin ID (Telegram user_id для админ команд)
ADMIN_ID=

# Daily Entry Limit
DAILY_ENTRY_LIMIT=50
